    { "id": "master.kiara.skill.s6", "aliases": ["s6"], "legacyId": "s6", "name": "此世全部之欲", "cardType": "master_skill", "owner": { "type": "master", "id": "master.kiara" }, "printedText": "当玩家部署于你所在的地点将移除游戏他们的一张【秘密花园】，如果他们无法移除则【败北】。当有玩家移动至你所在的地点，将弃置他们的所有手牌，如果他们弃置的手牌数低于3张则【败北】。", "cardFace": { "typeLabel": "被动", "attributes": [], "cost": 0, "basePower": 0 }, "playTiming": { "phase": "action", "window": "controller_play_card_window" }, "playRequirements": [], "abilities": [{ "id": "kiara.all-desires", "kind": "passive", "printedClause": "部署或移动至所在地点时移除秘密花园或败北，并处理手牌数量。", "activation": { "trigger": "while_active" }, "effects": [{ "type": "record_master_directive", "directive": "kiara_all_desires" }], "execution": { "mode": "automatic" } }], "verification": { "implementationStatus": "host_adjudicated" } }

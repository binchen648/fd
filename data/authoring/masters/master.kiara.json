    { "id": "master.kiara.skill.s2", "aliases": ["s2"], "legacyId": "s2", "name": "秘密花园", "cardType": "master_skill", "owner": { "type": "master", "id": "master.kiara" }, "printedText": "【无限的恐惧】战果3：当【钻石领域】放置入场时，展示此牌。当【钻石领域】打出时，杀生院以外的玩家抽3张牌。当此牌因【五停心观】展开时，若杀生院本回合未进行移动，其获得3点战果。\n【征服欲】战果2：当【此世全部之欲】放置入场时，展示此牌。【此世全部之欲】的威力-6。当此牌因【五停心观】展开时，若杀生院本回合未进行移动，其获得2点战果。\n【控制欲】战果2：当【此世全部之欲】放置入场时，展示此牌。当玩家移动至杀生院所在的地点时，【此世全部之欲】不触发效果。当此牌因【五停心观】展开时，若杀生院本回合未进行移动，其获得2点战果。\n【过往的遗憾】战果1：当【胎藏界】放置入场时，展示此牌。【胎藏界】无法在其打出的时候弃置事件牌。当此牌因【五停心观】展开时，若杀生院本回合未进行移动，其获得1点战果。\n【逃避现实】战果1：当【胎藏界】放置入场时，展示此牌。【胎藏界】无法在行动阶段开始时弃置事件牌。当此牌因【五停心观】展开时，若杀生院本回合未进行移动，其获得1点战果。\n【未来的恐惧】战果1：当【胎藏界】放置入场时，展示此牌。【胎藏界】无法在战斗阶段开始时弃置事件牌。当此牌因【五停心观】展开时，若杀生院本回合未进行移动，其获得1点战果。", "cardFace": { "typeLabel": "被动", "attributes": [], "cost": 0, "basePower": 0 }, "playTiming": { "phase": "action", "window": "controller_play_card_window" }, "playRequirements": [], "abilities": [{ "id": "kiara.secret-gardens", "kind": "passive", "printedClause": "六种秘密花园的展示、事件触发与战果效果。", "activation": { "trigger": "while_active" }, "effects": [{ "type": "record_master_directive", "directive": "kiara_secret_gardens" }], "execution": { "mode": "automatic" } }], "verification": { "implementationStatus": "host_adjudicated" } },
    { "id": "master.kiara.skill.s3", "aliases": ["s3"], "legacyId": "s3", "name": "天堂之孔", "cardType": "master_skill", "owner": { "type": "master", "id": "master.kiara" }, "printedText": "移除任意数量的技能牌，然后将【胎藏界】【钻石领域】【此世全部之欲】补充至你的技能区达到3个技能。你在准备阶段即进行你的前哨及行动阶段。", "cardFace": { "typeLabel": "被动", "attributes": [], "cost": 0, "basePower": 0 }, "playTiming": { "phase": "action", "window": "controller_play_card_window" }, "playRequirements": [], "abilities": [{ "id": "kiara.heavens-hole", "kind": "passive", "printedClause": "移除任意技能牌并补充三张指定技能至三项；准备阶段即进行前哨及行动阶段。", "activation": { "trigger": "while_active" }, "effects": [{ "type": "record_master_directive", "directive": "kiara_heavens_hole" }], "execution": { "mode": "automatic" } }], "verification": { "implementationStatus": "host_adjudicated" } },
    { "id": "master.kiara.skill.s4", "aliases": ["s4"], "legacyId": "s4", "name": "胎藏界·理拳印", "cardType": "master_skill", "owner": { "type": "master", "id": "master.kiara" }, "printedText": "当你打出此牌时，下个玩家行动阶段开始时，战斗阶段开始时，你可以弃置一张事件牌，然后抽一新事件牌代替。获得你因此能力弃置的所有事件牌战果数的合计威力。", "cardFace": { "typeLabel": "被动", "attributes": [], "cost": 0, "basePower": 0 }, "playTiming": { "phase": "action", "window": "controller_play_card_window" }, "playRequirements": [], "abilities": [{ "id": "kiara.garbha-fist-seal", "kind": "passive", "printedClause": "后续行动/战斗阶段可弃置事件并抽新事件替换，获得弃置事件战果合计威力。", "activation": { "trigger": "while_active" }, "effects": [{ "type": "record_master_directive", "directive": "kiara_garbha_fist_seal" }], "execution": { "mode": "automatic" } }], "verification": { "implementationStatus": "host_adjudicated" } },

    "clauseEvidence": [
      { "abilityId": "master.shirou-meal.skill.ascension", "text": "（此牌加入你的技能区）", "locator": "src/content/generated/legacy-content.json#masters[18].skills[2].text#line=1", "sha256": "04524fa1a93216241e9cc62d82f5b96a1c1555e8c864ee5d9b3b88ef37937921" },
      { "abilityId": "master.shirou-meal.skill.ascension", "text": "此牌需弃置一份【食物】来打出。", "locator": "src/content/generated/legacy-content.json#masters[18].skills[2].text#line=2", "sha256": "a1903f9ba6e11673b3e2fb5a11531d45a6830498a3a520768eaa5fb799966d33" },
      { "abilityId": "master.shirou-meal.skill.ascension", "text": "被动：你每有一份【食物】，你对应属性的基础攻击便+1威力。", "locator": "src/content/generated/legacy-content.json#masters[18].skills[2].text#line=3", "sha256": "d55e1d5a44d2e2cb3a76ddb02f9911193ae17a480bc8592ba5a6aea079662a85" },
      { "abilityId": "master.shirou-meal.skill.ascension", "text": "回合结束时，弃置你牌堆顶的一张牌。", "locator": "src/content/generated/legacy-content.json#masters[18].skills[2].text#line=4", "sha256": "cd8b4e5c5a962889acd1b24c599c710bae53fefcf3924f85a20b83c5781207e1" },
      { "abilityId": "master.shirou-meal.skill.s1", "text": "行动阶段：若你位于地利位置，你所在地点的事件牌和激活的局势牌上每具有一种非特殊或宝具的属性，你便获得一份相应的【食物】。（每种属性每回合仅提供一份食物——力量-肉，迅捷-蔬菜，魔术-鱼）", "locator": "src/content/generated/legacy-content.json#masters[18].skills[0].text#line=1", "sha256": "56f7b33b0418323d0044241be12b10c42b5761692a38c02bb359b0e378043bf5" },
      { "abilityId": "master.shirou-meal.skill.s1", "text": "【食物】用于制作【卫宫家今天的饭】。", "locator": "src/content/generated/legacy-content.json#masters[18].skills[0].text#line=2", "sha256": "62eaf020dd5d4a6f656ce832b2bc69b18eb4e369a4e9aa8fed6e0013d1d813cf" },
      { "abilityId": "master.shirou-meal.skill.s2", "text": "饕餮-当你因效果以外将弃牌堆洗回牌库时失去3点战果。", "locator": "src/content/generated/legacy-content.json#masters[18].skills[1].text#line=1", "sha256": "a8e94b33bce6804c4c167f625b3895deef234af3da4c5b50ceec447d57bd2162" },
      { "abilityId": "master.shirou-meal.skill.s2", "text": "行动阶段：弃置3份【食物】，下次洗牌你不会因饕餮失去战果。若你弃置了3种相同的【食物】，+6合计威力。若你弃置了3种不同的【食物】，获得4点魔力。", "locator": "src/content/generated/legacy-content.json#masters[18].skills[1].text#line=2", "sha256": "c403613b0016714dbdaf8b2521fda72ccb88be0e5b779ba57f2743afeedcd9d5" }

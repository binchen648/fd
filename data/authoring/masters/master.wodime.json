  "cards":[
    {"id":"master.wodime.skill.ascension","aliases":["ascension"],"legacyId":"ascension","name":"冠位指定","cardType":"master_skill","owner":{"type":"master","id":"master.wodime"},"printedText":"你每赢得一场战斗即可额外秘密写入一个回合数以触发【人理保障天球】。","cardFace":{"typeLabel":"升华技","attributes":[],"cost":0,"basePower":0},"playTiming":{"phase":"action","window":"controller_play_card_window"},"playRequirements":[],"abilities":[{"id":"wodime.ascension","kind":"passive","printedClause":"你每赢得一场战斗即可额外秘密写入一个回合数以触发【人理保障天球】。","activation":{"trigger":"after_controller_wins_battle"},"effects":[{"type":"wodime_astrology_ascension_record"}],"execution":{"mode":"automatic"}}],"verification":{"implementationStatus":"complete"}},
    {"id":"master.wodime.skill.s1","aliases":["s1"],"legacyId":"s1","name":"隐匿者之首","cardType":"master_skill","owner":{"type":"master","id":"master.wodime"},"printedText":"你负责【亚特兰蒂斯】和【奥林匹斯】异闻带。\n游戏开始时，扩张【亚特兰蒂斯】。\n行动阶段：支付5个【神之遗产】，扩张【奥林匹斯】。","cardFace":{"typeLabel":"被动","attributes":[],"cost":0,"basePower":0},"playTiming":{"phase":"action","window":"controller_play_card_window"},"playRequirements":[],"abilities":[{"id":"wodime.crypter","kind":"passive","printedClause":"你负责【亚特兰蒂斯】和【奥林匹斯】异闻带。\n游戏开始时，扩张【亚特兰蒂斯】。\n行动阶段：支付5个【神之遗产】，扩张【奥林匹斯】。","activation":{"trigger":"while_active"},"effects":[{"type":"record_master_directive","directive":"wodime_atlantis_olympus_lostbelts"}],"execution":{"mode":"automatic"}}],"verification":{"implementationStatus":"host_adjudicated"}},
    {"id":"master.wodime.skill.s1a","aliases":["s1a"],"legacyId":"s1a","name":"天体学","cardType":"master_skill","owner":{"type":"master","id":"master.wodime"},"printedText":"秘密记录两个回合数并将【人理保障天球】加入你的技能区。","cardFace":{"typeLabel":"被动","attributes":[],"cost":0,"basePower":0},"playTiming":{"phase":"action","window":"controller_play_card_window"},"playRequirements":[],"abilities":[{"id":"wodime.astrology","kind":"forced_trigger","printedClause":"秘密记录两个回合数并将【人理保障天球】加入你的技能区。","activation":{"trigger":"game_start"},"conditions":[],"targets":[{"id":"wodime_astrology_rounds","type":"choice","options":[{"id":"round:1"},{"id":"round:2"},{"id":"round:3"},{"id":"round:4"},{"id":"round:5"},{"id":"round:6"},{"id":"round:7"},{"id":"round:8"},{"id":"round:9"},{"id":"round:10"},{"id":"round:11"}],"count":{"min":2,"max":2}}],"effects":[{"type":"wodime_astrology_round_selection","target":"wodime_astrology_rounds","provisionDefinitionId":"master.wodime.skill.s2"}],"cost":[],"ruleModifiers":[],"creates":[],"lifecycle":{},"responseWindow":{},"limit":{},"visibility":{},"execution":{"mode":"automatic","allowedOperations":[]}}],"verification":{"implementationStatus":"complete"}},
    {"id":"master.wodime.skill.s2","aliases":["s2"],"legacyId":"s2","name":"人理保障天球","cardType":"master_skill","owner":{"type":"master","id":"master.wodime"},"printedText":"星体回路-被动/战斗阶段：若你以天体学记录了本回合，打出此牌（你拥有的魔力少于8点也可打出），战力结算时，忽略你其他攻击的威力。此牌不能通过其他任何方式入场。","cardFace":{"typeLabel":"被动","attributes":[],"cost":0,"basePower":0},"playTiming":{"phase":"action","window":"controller_play_card_window"},"playRequirements":[{"type":"skill_zone_mana_at_least","value":8}],"abilities":[{"id":"wodime.orb","kind":"forced_trigger","printedClause":"星体回路-被动/战斗阶段：若你以天体学记录了本回合，打出此牌（你拥有的魔力少于8点也可打出），战力结算时，忽略你其他攻击的威力。此牌不能通过其他任何方式入场。","activation":{"trigger":"on_card_played"},"conditions":[],"targets":[],"cost":[],"ruleModifiers":[],"creates":[],"lifecycle":{},"responseWindow":{},"limit":{},"visibility":{},"effects":[{"type":"wodime_celestial_sphere_battle"}],"execution":{"mode":"automatic","allowedOperations":[]}}],"verification":{"implementationStatus":"complete"}},
    {"id":"master.wodime.skill.s3","aliases":["s3"],"legacyId":"s3","name":"神之遗产","cardType":"master_skill","owner":{"type":"master","id":"master.wodime"},"printedText":"【神之遗产】在【沃戴姆】被淘汰后将持续存在。当一名玩家从有【神之遗产】的地点移动时，他将带走等同于其地利位置数的【神之遗产】。当玩家在有【神之遗产】的地点是唯一的获胜者时，他将获得所有余下的【神之遗产】。\n拥有【神之遗产】的玩家获得：行动阶段：支付3X个【神之遗产】，获得X点合计威力（X最大为3）。行动阶段：支付4X个【神之遗产】，获得X点魔力。","cardFace":{"typeLabel":"被动","attributes":[],"cost":0,"basePower":0},"playTiming":{"phase":"action","window":"controller_play_card_window"},"playRequirements":[],"abilities":[{"id":"wodime.god-legacy","kind":"passive","printedClause":"【神之遗产】在【沃戴姆】被淘汰后将持续存在。当一名玩家从有【神之遗产】的地点移动时，他将带走等同于其地利位置数的【神之遗产】。当玩家在有【神之遗产】的地点是唯一的获胜者时，他将获得所有余下的【神之遗产】。\n拥有【神之遗产】的玩家获得：行动阶段：支付3X个【神之遗产】，获得X点合计威力（X最大为3）。行动阶段：支付4X个【神之遗产】，获得X点魔力。","activation":{"trigger":"while_active"},"effects":[{"type":"record_master_directive","directive":"wodime_god_legacy_tokens"}],"execution":{"mode":"automatic"}}],"verification":{"implementationStatus":"host_adjudicated"}},
    {"id":"master.wodime.skill.s4","aliases":["s4"],"legacyId":"s4","name":"亚特兰蒂斯异闻带","cardType":"master_skill","owner":{"type":"master","id":"master.wodime"},"printedText":"当【亚特兰蒂斯】事件牌被揭示时，如果在战场上，则结算其效果并将之移出游戏，否则将其洗回牌库。无论以上哪种情况，抽取一张新的事件牌置于它所在的位置。\n扩张-将所有【亚特兰蒂斯】事件牌洗入牌库。","cardFace":{"typeLabel":"被动","attributes":[],"cost":0,"basePower":0},"playTiming":{"phase":"action","window":"controller_play_card_window"},"playRequirements":[],"abilities":[{"id":"wodime.atlantis","kind":"passive","printedClause":"当【亚特兰蒂斯】事件牌被揭示时，如果在战场上，则结算其效果并将之移出游戏，否则将其洗回牌库。无论以上哪种情况，抽取一张新的事件牌置于它所在的位置。\n扩张-将所有【亚特兰蒂斯】事件牌洗入牌库。","activation":{"trigger":"while_active"},"effects":[{"type":"record_master_directive","directive":"wodime_atlantis_lostbelt"}],"execution":{"mode":"automatic"}}],"verification":{"implementationStatus":"host_adjudicated"}},
    {"id":"master.wodime.skill.s5","aliases":["s5"],"legacyId":"s5","name":"奥林匹斯异闻带","cardType":"master_skill","owner":{"type":"master","id":"master.wodime"},"printedText":"扩张-抽取并展示2张事件牌。你可以将其中一张替换为游戏外的【奥林匹斯】事件牌（替换时为正面），然后将它们洗回事件牌堆。同时满足扩张条件的玩家需要同步执行扩张。","cardFace":{"typeLabel":"被动","attributes":[],"cost":0,"basePower":0},"playTiming":{"phase":"action","window":"controller_play_card_window"},"playRequirements":[],"abilities":[{"id":"wodime.olympus","kind":"passive","printedClause":"扩张-抽取并展示2张事件牌。你可以将其中一张替换为游戏外的【奥林匹斯】事件牌（替换时为正面），然后将它们洗回事件牌堆。同时满足扩张条件的玩家需要同步执行扩张。","activation":{"trigger":"while_active"},"effects":[{"type":"record_master_directive","directive":"wodime_olympus_lostbelt"}],"execution":{"mode":"automatic"}}],"verification":{"implementationStatus":"host_adjudicated"}},
    {"id":"master.wodime.skill.s6","aliases":["s6"],"legacyId":"s6","name":"赫菲斯托斯终端","cardType":"master_skill","owner":{"type":"master","id":"master.wodime"},"printedText":"【亚特兰蒂斯事件牌】战果0，数量6。\n将3个【神之遗产】放置于此地点。所有玩家获得1个【神之遗产】。","cardFace":{"typeLabel":"被动","attributes":[],"cost":0,"basePower":0},"playTiming":{"phase":"action","window":"controller_play_card_window"},"playRequirements":[],"abilities":[{"id":"wodime.hephaestus","kind":"passive","printedClause":"【亚特兰蒂斯事件牌】战果0，数量6。\n将3个【神之遗产】放置于此地点。所有玩家获得1个【神之遗产】。","activation":{"trigger":"while_active"},"effects":[{"type":"record_master_directive","directive":"wodime_hephaestus_event"}],"execution":{"mode":"automatic"}}],"verification":{"implementationStatus":"host_adjudicated"}},
    {"id":"master.wodime.skill.s7","aliases":["s7"],"legacyId":"s7","name":"宙斯的雷霆","cardType":"master_skill","owner":{"type":"master","id":"master.wodime"},"printedText":"【奥林匹斯事件牌】战果5，数量2。\n【沃戴姆】的对手位于此战场时不能无视【败北】效果。计算战力后，使此处战力未达到21的所有人【败北】。","cardFace":{"typeLabel":"被动","attributes":[],"cost":0,"basePower":0},"playTiming":{"phase":"action","window":"controller_play_card_window"},"playRequirements":[],"abilities":[{"id":"wodime.zeus","kind":"passive","printedClause":"【奥林匹斯事件牌】战果5，数量2。\n【沃戴姆】的对手位于此战场时不能无视【败北】效果。计算战力后，使此处战力未达到21的所有人【败北】。","activation":{"trigger":"while_active"},"effects":[{"type":"record_master_directive","directive":"wodime_zeus_event"}],"execution":{"mode":"automatic"}}],"verification":{"implementationStatus":"host_adjudicated"}},

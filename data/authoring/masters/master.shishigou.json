    "clauseEvidence": [
      { "abilityId": "master.shishigou.skill.ascension", "text": "你所有的的基础牌得到效果：\"行动阶段：花费3点魔力，根据此牌属性激活【死灵魔术】。\"", "locator": "src/content/generated/legacy-content.json#masters[48].skills[3].text#line=1", "sha256": "6818b3442e213f8c3f176b30427356c5531b3fc4358e2ae8635090ee2daaf521" },
      { "abilityId": "master.shishigou.skill.s1", "text": "行动阶段：展示一张以尸体冷藏移除的暗置牌（展示后该暗置牌不再暗置且不可再被展示），根据被展示牌的属性，使用一种属性符合的【死灵魔术】。", "locator": "src/content/generated/legacy-content.json#masters[48].skills[0].text#line=1", "sha256": "06b0b58708bc72a81654b9c13883d8c5273eddc797a8b56b23abce3d9c9145da" },
      { "abilityId": "master.shishigou.skill.s1", "text": "战斗阶段：若你位于魔术工房，将一张你控制的暗置攻击移除游戏（不展示）。", "locator": "src/content/generated/legacy-content.json#masters[48].skills[0].text#line=2", "sha256": "99abce3e80d6143243bd0a3cb0a8959a4713fb5fea497803e6b8d7f275b4708b" },
      { "abilityId": "master.shishigou.skill.s2", "text": "力量属性-心脏手雷-移动至一处战场并获得2点地利。", "locator": "src/content/generated/legacy-content.json#masters[48].skills[1].text#line=1", "sha256": "9d04c25feb7414294fc5ba4c3c6689d934d23584489433141ec846d4a0b64d61" },
      { "abilityId": "master.shishigou.skill.s2", "text": "迅捷属性-魔术指弹-打出你牌库顶的牌（支付其消耗）。", "locator": "src/content/generated/legacy-content.json#masters[48].skills[1].text#line=2", "sha256": "03ef82051f65cbc107031214a6d63342afad130ddfd918e6cb4042eeb18e5270" },
      { "abilityId": "master.shishigou.skill.s3", "text": "魔术属性-猫头鹰的眼球-将你的地利变为2倍。", "locator": "src/content/generated/legacy-content.json#masters[48].skills[2].text#line=1", "sha256": "ba0c8d77b066e624a6ec14e7eb153cae7b65a0b66cbbeec7b6e4ec1ffe520e91" },

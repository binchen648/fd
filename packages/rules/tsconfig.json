{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.json"
  ],
  "exclude": [
    "dist",
    "src/phases/**/*.ts"
  ],
  "references": [
    {
      "path": "../contracts"
    },
    {
      "path": "../content"
    },
    {
      "path": "../game-contracts"
    }
  ]
}
